# Kopieren nach .env und ausfüllen. .env wird nie committet.
# BingX-API-Key NUR mit Lese-Rechten anlegen.
BX_KEY=
BX_SECRET=

# HTTP-API
PORT=3000
HOST=127.0.0.1
# Nur Loopback erlaubt (API ohne Authentifizierung). Anderer HOST nur mit ALLOW_REMOTE=true.
# ALLOW_REMOTE=true
# Mit ALLOW_REMOTE=true Pflicht: weitere erlaubte Host-Header (host:port, kommagetrennt), Schutz vor DNS-Rebinding.
# ALLOWED_HOSTS=meinrechner.local:3000

# Positions-Import (optional, Defaults in Klammern)
# BingX-API-Basis-URL (https://open-api.bingx.com)
# BX_BASE=https://open-api.bingx.com
# Pfad zur SQLite-Datenbank, relativ zu backend/ (data/journal.sqlite)
# JOURNAL_DB=data/journal.sqlite
# Tage Historie beim ersten Vollimport, ganze Zahl > 0 (365)
# IMPORT_FULL_DAYS=365
