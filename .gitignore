# Abhängigkeiten und Build-Ausgaben
node_modules/
dist/
# Eingebettetes Web-UI: Release-Build kopiert hierhin, nur der Platzhalter bleibt
!backend-go/internal/presentation/webui/dist/
backend-go/internal/presentation/webui/dist/*
!backend-go/internal/presentation/webui/dist/.gitkeep
coverage/

# Secrets: nur die Vorlage wird committet
.env
.env.*
!.env.example

# Logs und System
*.log
.DS_Store

# Lokale Daten (SQLite-Journal)
data/

# Lokale Editor- und Werkzeug-Einstellungen
.idea/
.claude/settings.local.json

# Go-Binary aus `go build -o tip-server ./cmd/tip-server`
/backend-go/tip-server

# Screenshots des designer-Agenten
clients/web/screenshots/
