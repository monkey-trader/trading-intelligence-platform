e Zahl (Format wie Einstieg); aria-live nur beim Wechsel Daten/'veraltet', nicht pro Tick;\n24h-Farbe nur Tokens (gewinn/verlust) + Vorzeichen +/-; Abstand: positiv = Level noch vor dem Kurs, negativ = ueberschritten (Text 'erreicht'), null = '-'.", "originalText": "Regeln: tabellarische Ziffern; Kurs = reine kopierbare Zahl (Format wie Einstieg); aria-live nur beim Wechsel Daten/'veraltet', nicht pro Tick;\n24h-Farbe nur Tokens (gewinn/verlust) + Vorzeichen +/-; Abstand: positiv = Level noch vor dem Kurs, negativ = ueberschritten (Text 'erreicht'), null = '-'.", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e28", "x": 20, "y": 330, "width": 453.59999999999997, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 28, "version": 1, "versionNonce": 1027, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "text": "A: Kurs-Spalte + Abstand in BE-/TP1-Zellen", "originalText": "A: Kurs-Spalte + Abstand in BE-/TP1-Zellen", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25}, {"type": "text", "id": "e29", "x": 20, "y": 356, "width": 525.6, "height": 45.0, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "seed": 29, "version": 1, "versionNonce": 1028, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "text": "Kurs mit 24h-% darunter; BE/TP1-Zellen bekommen 2. Zeile Abstand. Pro:\nkompakt, 1280 px ohne Scroll, nichts Neues zu lernen. Contra: Abstand ist\nKleintext.", "originalText": "Kurs mit 24h-% darunter; BE/TP1-Zellen bekommen 2. Zeile Abstand. Pro:\nkompakt, 1280 px ohne Scroll,